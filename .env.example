# 模型配置（OpenAI 兼容接口，默认智谱 BigModel）
MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MODEL_API_KEY=
MODEL_NAME=glm-4.7-flash

# 是否强制使用 FakeModel（演示，无需 API Key）
# 留空时：若未设置 MODEL_API_KEY，则自动使用 FakeModel
USE_FAKE_MODEL=

# Agent 运行配置
MAX_STEPS=20
MAX_CONTEXT_TOKENS=8000
MAX_OUTPUT_TOKENS=4096
TOOL_TIMEOUT_MS=30000
PARSE_RETRY=2
WORKSPACE_ROOT=.
USE_LLM_PLANNING=false